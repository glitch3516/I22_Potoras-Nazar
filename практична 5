<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Каталог комп'ютерної техніки</title>
</head>
<body>

    <!-- Таблиця з рамкою для наочності без CSS -->
    <table border="1" cellpadding="8" cellspacing="0">
        <!-- Назва таблиці -->
        <caption>Каталог комп'ютерної техніки</caption>

        <!-- Верхня частина із заголовками -->
        <thead>
            <tr>
                <th rowspan="2">Категорія</th>
                <th colspan="2">Інформація про товар</th>
                <th rowspan="2">Ціна (грн)</th>
                <th rowspan="2">Наявність</th>
            </tr>
            <tr>
                <th>Назва товару</th>
                <th>Виробник</th>
            </tr>
        </thead>

        <!-- Основна частина з даними -->
        <tbody>
            <tr>
                <!-- Спільна комірка категорії для двох товарів (об'єднання по вертикалі) -->
                <td rowspan="2">Периферія</td>
                <td>Клавіатура мембранна</td>
                <td>Logitech</td>
                <td>850</td>
                <td>В наявності</td>
            </tr>
            <tr>
                <td>Миша бездротова</td>
                <td>Razer</td>
                <td>1200</td>
                <td>В наявності</td>
            </tr>
            <tr>
                <td>Комп'ютери</td>
                <td>Ноутбук ThinkPad</td>
                <td>Lenovo</td>
                <td>28000</td>
                <td>Під замовлення</td>
            </tr>
            <tr>
                <td>Монітори</td>
                <td>Монітор 24" IPS</td>
                <td>Dell</td>
                <td>5400</td>
                <td>В наявності</td>
            </tr>
            <tr>
                <td>Аудіо</td>
                <td>Навушники ігрові</td>
                <td>HyperX</td>
                <td>2100</td>
                <td>Закінчується</td>
            </tr>
        </tbody>

        <!-- Підсумкова частина (об'єднання по горизонталі) -->
        <tfoot>
            <tr>
                <td colspan="4">Всього товарів:</td>
                <td>5</td>
            </tr>
        </tfoot>
    </table>

</body>
</html>
